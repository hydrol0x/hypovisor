# Copy to .env (or export these) before running.

# SQLite by default. For Postgres: postgresql+psycopg://user:pass@localhost:5432/hypovisor
HYPOVISOR_DATABASE_URL=sqlite:///./data/hypovisor.db

# IANA timezone that pump/CGM exports are in (they contain local times only).
HYPOVISOR_TIMEZONE=America/New_York

# Where uploaded meal photos are stored.
HYPOVISOR_PHOTO_DIR=./data/photos

# Glucose targets (mg/dL) used for time-in-range and meal scoring.
HYPOVISOR_TARGET_LOW=70
HYPOVISOR_TARGET_HIGH=180

# Insulin model used for insulin-on-board estimates.
HYPOVISOR_DIA_MINUTES=300
HYPOVISOR_INSULIN_PEAK_MINUTES=75

# Which CGM source wins when the same reading arrives from several places.
HYPOVISOR_PREFERRED_CGM_SOURCE=dexcom_clarity

# Claude model used for food recognition and nutrient estimation.
ANTHROPIC_API_KEY=
HYPOVISOR_ANTHROPIC_MODEL=claude-opus-5-5

# Optional: USDA FoodData Central API key (https://fdc.nal.usda.gov/api-key-signup.html)
USDA_FDC_API_KEY=

# Optional: Nightscout instance for live sync (API v3 token with read access)
NIGHTSCOUT_URL=
NIGHTSCOUT_TOKEN=

# Optional: Dexcom Developer API (delayed, official). Sandbox: https://sandbox-api.dexcom.com
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=http://localhost:8000/api/sync/dexcom/callback
DEXCOM_BASE_URL=https://api.dexcom.com
